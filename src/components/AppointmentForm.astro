---
import L from './L.astro';
import { site as s } from '../data/site.js';
import { days } from '../lib/i18n.js';
const docs = s.doctors.map(d => ({ n: d.name.en, sp: d.specialty.en, d: d.d }));
---
<div class="fm" id="apt" data-wa={s.whatsapp}>
  <div><h3><L k="s1" /></h3>
    <select id="doc" style="width:100%">{s.doctors.map((d,i) => <option value={i}>{d.name.en} – {d.specialty.en}</option>)}</select></div>
  <div><h3><L k="s2" /></h3><div class="cal">
    <div class="hd"><select id="mon" aria-label="Month"></select><select id="yr" aria-label="Year"></select></div>
    <div class="wk">{days.map(x => <span><L o={x} /></span>)}</div><div class="gr" id="grid"></div>
    <div class="lg"><span><i class="g"></i><L k="avl" /></span><span><i></i><L k="nav" /></span></div></div>
    <p class="selv" id="sel"></p></div>
  <form id="apform"><h3><L k="s3" /></h3>
    <label><L k="an" /><input name="n" required /></label>
    <label><L k="ap2" /><input name="m" type="tel" required inputmode="tel" /></label>
    <label><L k="age" /><input name="a" type="number" min="0" max="120" required /></label>
    <button class="btn main" type="submit"><L k="send" /></button></form>
</div>
<script define:vars={{ docs }}>
(function(){
var H=document.documentElement,$=function(i){return document.getElementById(i)};
var sel=$('doc'),ms=$('mon'),ys=$('yr'),grid=$('grid'),out=$('sel'),picked=null;
var now=new Date(),today=new Date(now.getFullYear(),now.getMonth(),now.getDate());
var loc=function(){return H.lang==='bn'?'bn-BD':'en-GB'};
var num=function(n){return n.toLocaleString(loc(),{useGrouping:false})};
for(var y=today.getFullYear();y<=today.getFullYear()+1;y++)ys.add(new Option('',y));
for(var m=0;m<12;m++)ms.add(new Option('',m));
ms.value=today.getMonth();ys.value=today.getFullYear();
var q=+new URLSearchParams(location.search).get('doctor');if(docs[q])sel.value=q;
function show(err){out.className='selv'+(err?' err':'');
out.textContent=picked?new Date(picked).toLocaleDateString(loc(),{weekday:'long',day:'numeric',month:'long',year:'numeric'}):(H.lang==='bn'?'কোনো তারিখ বেছে নেওয়া হয়নি':'No date selected')}
function render(){
for(var i=0;i<12;i++)ms.options[i].text=new Date(2026,i,1).toLocaleString(loc(),{month:'long'});
for(i=0;i<ys.options.length;i++)ys.options[i].text=num(+ys.options[i].value);
var doc=docs[+sel.value],yy=+ys.value,mm=+ms.value,lead=(new Date(yy,mm,1).getDay()+1)%7,len=new Date(yy,mm+1,0).getDate(),h='';
for(i=0;i<lead;i++)h+='<i></i>';
for(var d=1;d<=len;d++){var dt=new Date(yy,mm,d),ok=doc.d.indexOf((dt.getDay()+1)%7)>-1&&dt>=today;
h+='<button type="button" class="c'+(ok?' ok':'')+(picked===+dt?' pk':'')+'" data-t="'+(+dt)+'"'+(ok?'':' disabled')+'>'+num(d)+'</button>'}
grid.innerHTML=h;show()}
sel.addEventListener('change',function(){picked=null;render()});
ms.addEventListener('change',render);ys.addEventListener('change',render);
grid.addEventListener('click',function(e){var b=e.target.closest('.ok');if(b){picked=+b.dataset.t;render()}});
new MutationObserver(render).observe(H,{attributes:true,attributeFilter:['lang']});
$('apform').addEventListener('submit',function(e){e.preventDefault();
if(!picked){show(true);out.scrollIntoView({block:'center'});return}
var f=new FormData(e.target),doc=docs[+sel.value];
var msg='Appointment request\nDoctor: '+doc.n+' ('+doc.sp+')\nDate: '+new Date(picked).toLocaleDateString('en-GB',{weekday:'long',day:'numeric',month:'long',year:'numeric'})+'\nPatient: '+f.get('n')+'\nAge: '+f.get('a')+'\nMobile: '+f.get('m');
window.open('https://wa.me/'+$('apt').dataset.wa+'?text='+encodeURIComponent(msg),'_blank')});
render()})();
</script>
