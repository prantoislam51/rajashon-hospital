---
import Layout from '../layouts/Layout.astro';
import L from '../components/L.astro';
import { site as s } from '../data/site.js';
import { u, tel } from '../lib/i18n.js';
const fmt = (n, l) => '৳ ' + n.toLocaleString(l);
const count = (k) => s.tests.filter(t => t.cat === k).length;
const groups = Object.entries(s.testGroups).map(([g, v]) => ({ g, v, cats: Object.entries(s.testCats).filter(([k, c]) => c.g === g && count(k) > 0) })).filter(x => x.cats.length);
---
<Layout title={u.tests} sub={u.tsub}>
<section><div class="wrap">
  {s.testsDemo && <div class="demo"><L k="demoN" /></div>}
  <div class="flt">
    <input class="srch" id="q" type="search" placeholder="Search / খুঁজুন" aria-label="Search" />
    <select id="cat" aria-label="Category">
      <option value="" data-en={u.allc.en} data-bn={u.allc.bn}>{u.allc.en}</option>
      {groups.map(x => <optgroup label={x.v.en} data-en={x.v.en} data-bn={x.v.bn}>{x.cats.map(([k, c]) => <option value={k} data-en={`${c.en} (${count(k)})`} data-bn={`${c.bn} (${count(k).toLocaleString('bn-BD')})`}>{c.en} ({count(k)})</option>)}</optgroup>)}
    </select>
  </div>
  <p class="cnt" id="cnt"></p>
  <div class="tw"><table class="tt"><thead><tr><th><L k="tname" /></th><th><L k="cat" /></th><th><L k="tprice" /></th><th><L k="trep" /></th><th><L k="tprep" /></th></tr></thead>
  <tbody>{s.tests.map(t => <tr data-c={t.cat} data-s={(t.en + ' ' + t.bn + ' ' + s.testCats[t.cat].en + ' ' + s.testCats[t.cat].bn).toLowerCase()}>
    <td class="nm"><L o={t} /></td>
    <td><span class="lbl"><L k="cat" /></span><span class="ty"><L o={s.testCats[t.cat]} /></span></td>
    <td>{t.price == null ? <span class="pr cp"><L k="callp" /></span> : <span class="pr"><Fragment set:html={`<span class="en">${fmt(t.price,'en-US')}</span><span class="bn">${fmt(t.price,'bn-BD')}</span>`} /></span>}</td>
    <td><span class="lbl"><L k="trep" /></span><span><L o={t.report} /></span></td>
    <td><span class="lbl"><L k="tprep" /></span><span><L o={t.prep} /></span></td></tr>)}</tbody></table></div>
  <p class="dn" id="dn" hidden><L k="nores" /></p>
  <p class="note"><L k="tnote" /> <a href={tel(s.phones[0])}><b>{s.phones[0]}</b></a></p>
</div></section>
</Layout>
<script is:inline>
(function(){var H=document.documentElement,q=document.getElementById('q'),sel=document.getElementById('cat'),cnt=document.getElementById('cnt'),rows=[].slice.call(document.querySelectorAll('.tt tbody tr'));
function lang(){var b=H.lang==='bn';[].forEach.call(sel.querySelectorAll('option,optgroup'),function(o){var t=b?o.dataset.bn:o.dataset.en;if(o.tagName==='OPTION')o.text=t;else o.label=t});f()}
function f(){var t=q.value.trim().toLowerCase(),c=sel.value,n=0,b=H.lang==='bn';
rows.forEach(function(r){var ok=(!c||r.dataset.c===c)&&(!t||r.dataset.s.indexOf(t)>-1);r.hidden=!ok;if(ok)n++});
var N=function(x){return x.toLocaleString(b?'bn-BD':'en-US',{useGrouping:false})};
cnt.textContent=b?N(rows.length)+'টির মধ্যে '+N(n)+'টি টেস্ট দেখানো হচ্ছে':'Showing '+n+' of '+rows.length+' tests';
document.getElementById('dn').hidden=n>0}
q.addEventListener('input',f);sel.addEventListener('change',f);
new MutationObserver(lang).observe(H,{attributes:true,attributeFilter:['lang']});lang()})();
</script>
