---
import '../styles/global.css';
import L from '../components/L.astro';
import { site as s } from '../data/site.js';
import { tel } from '../lib/i18n.js';
const { title, sub } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [['/', 'home'], ['/about', 'about'], ['/doctors', 'doctors'], ['/appointment', 'apt'], ['/services', 'services'], ['/reports', 'reports'], ['/contact', 'contact']];
---
<!doctype html>
<html lang="en" data-theme="light">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title ? title + ' | ' : ''}Rajashon Hospital &amp; Diagnostic Center | রাজাসন হসপিটাল</title>
<meta name="description" content="Rajashon Hospital & Diagnostic Center, Birulia Road, Savar, Dhaka." />
<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap" rel="stylesheet" />
<script is:inline>
(function(){var d=document.documentElement,g=function(k){try{return localStorage.getItem(k)}catch(e){return null}};
var t;try{t=sessionStorage.getItem('theme')}catch(e){}d.lang=g('lang')||'en';d.dataset.theme=t||'light'})();
</script>
</head>
<body>
<header><div class="wrap bar">
  <a class="brand" href="/"><span class="rx">Rx</span><span><L o={s.short} /></span></a>
  <nav>{nav.map(([h,k]) => <a href={h} class={path===h?'on':''}><L k={k} /></a>)}</nav>
  <div class="tools"><button type="button" id="langBtn"><span class="en">বাংলা</span><span class="bn">English</span></button><button type="button" id="themeBtn" aria-label="Day / night">◐</button></div>
</div></header>
{title && <div class="pagehead"><div class="wrap"><h1><L o={title} /></h1>{sub && <p><L o={sub} /></p>}</div></div>}
<main><slot /></main>
<footer><div class="wrap">© {new Date().getFullYear()} <L o={s.name} /></div></footer>
<div class="fab"><a href={tel(s.phones[0])}><L k="serial" /></a><a href="/appointment"><L k="book" /></a></div>
<script is:inline>
(function(){var d=document.documentElement,set=function(k,v){try{localStorage.setItem(k,v)}catch(e){}};
document.getElementById('langBtn').addEventListener('click',function(){d.lang=d.lang==='en'?'bn':'en';set('lang',d.lang)});
document.getElementById('themeBtn').addEventListener('click',function(){d.dataset.theme=d.dataset.theme==='dark'?'light':'dark';try{sessionStorage.setItem('theme',d.dataset.theme)}catch(e){}})})();
</script>
<script is:inline>
document.addEventListener('click',function(e){var c=e.target.closest('.dcard');
if(c&&!e.target.closest('a')){var m=document.getElementById(c.dataset.m);if(m)m.showModal();return}
if(e.target.closest('[data-close]')){e.target.closest('dialog').close();return}
if(e.target.tagName==='DIALOG')e.target.close()});
</script>
</body></html>
